<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PowerPlanTray</AssemblyName>
    <RootNamespace>PowerPlanTray</RootNamespace>
    <Version>1.6.1</Version>
    <AssemblyVersion>1.6.1.0</AssemblyVersion>
    <FileVersion>1.6.1.0</FileVersion>
    <CodexEdition Condition="'$(CodexEdition)' == ''">true</CodexEdition>
    <DefineConstants Condition="'$(CodexEdition)' == 'true'">$(DefineConstants);CODEX_EDITION</DefineConstants>
    <DefineConstants Condition="'$(LocalTest)' == 'true'">$(DefineConstants);LOCAL_TEST</DefineConstants>
    <ApplicationIcon>assets\PowerPlanTray.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="GenerateApplicationIcon" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;[IO.File]::WriteAllBytes('$(MSBuildProjectDirectory)\assets\PowerPlanTray.ico',[Convert]::FromBase64String([IO.File]::ReadAllText('$(MSBuildProjectDirectory)\assets\PowerPlanTray.ico.b64')))&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="assets\bolt-white.svg" />
    <EmbeddedResource Include="assets\hp-white.svg" />
  </ItemGroup>
</Project>
